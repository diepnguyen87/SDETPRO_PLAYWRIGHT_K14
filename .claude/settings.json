{
  "permissions": {
    "allow": [
      "Bash(yarn playwright:*)",
      "Bash(npx playwright:*)",
      "Bash(yarn test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
